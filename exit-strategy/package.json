{
  "name": "exit-strategy",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter '!@exit/ethics' --filter '!@exit/sim' test",
    "test:ethics": "pnpm --filter @exit/ethics test",
    "test:sim": "pnpm --filter @exit/sim test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
